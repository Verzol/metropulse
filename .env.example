# MetroPulse local environment template.
# Copy this file to .env, then update secrets and host-specific values.

# MinIO Credentials
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
YELLOW_TAXI_TOPIC=nyc_taxi_yellow
GREEN_TAXI_TOPIC=nyc_taxi_green
KAFKA_MAX_OFFSETS_PER_TRIGGER=1000000
BRONZE_TRIGGER_AVAILABLE_NOW=true

# Producer mode: raw keeps Bronze immutable; legacy_enriched is only a fallback.
TAXI_PRODUCER_PAYLOAD_MODE=raw
TAXI_PRODUCER_PARQUET_BATCH_ROWS=50000
TAXI_PRODUCER_FLUSH_EVERY_RECORDS=50000
TAXI_PRODUCER_KAFKA_BATCH_SIZE=131072
TAXI_PRODUCER_LINGER_MS=100
TAXI_PRODUCER_BUFFER_MEMORY=268435456

# MinIO Lakehouse Paths
BRONZE_YELLOW_PATH=s3a://bronze/yellow_taxi/
BRONZE_GREEN_PATH=s3a://bronze/green_taxi/
BRONZE_WEATHER_PATH=s3a://bronze/weather/
SILVER_ROOT_PATH=s3a://silver
SILVER_WEATHER_PATH=s3a://silver/hourly_weather/
SILVER_TAXI_WEATHER_PATH=s3a://silver/taxi_weather_trips/
SILVER_TAXI_WEATHER_CORE_PATH=s3a://silver/taxi_weather_trips_core/
SILVER_TAXI_WEATHER_CLEAN_PATH=s3a://silver/taxi_weather_trips_clean/
SILVER_QUALITY_REPORT_PATH=s3a://silver/quality_reports/silver_core_quality/latest/
SILVER_PICKUP_START_DATE=2023-01-01
SILVER_PICKUP_END_DATE=2025-01-01
SPARK_SQL_SHUFFLE_PARTITIONS=48

# Airflow Configuration
# Set these on the VM with:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
#   echo "DOCKER_GID=$(getent group docker | cut -d: -f3)" >> .env
#   echo "DOCKER_SOCKET_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
AIRFLOW_UID=50000
DOCKER_GID=109
DOCKER_SOCKET_GID=65534
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_for_shared_vm
# Airflow metadata database credentials; set these before starting Airflow.
AIRFLOW_METADATA_DB_USER=airflow
AIRFLOW_METADATA_DB_PASSWORD=CHANGE_ME_AIRFLOW_METADATA_DB_PASSWORD
AIRFLOW_METADATA_DB_NAME=airflow

# PostgreSQL Data Warehouse / Serving Layer
# Warehouse is separate from Airflow metadata PostgreSQL.
WAREHOUSE_POSTGRES_HOST=warehouse-postgres
WAREHOUSE_POSTGRES_BIND_ADDRESS=127.0.0.1
WAREHOUSE_POSTGRES_HOST_PORT=5433
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DB=metropulse_dw
WAREHOUSE_POSTGRES_USER=metropulse_dw
WAREHOUSE_POSTGRES_PASSWORD=CHANGE_ME_WAREHOUSE_PASSWORD
WAREHOUSE_JDBC_URL=jdbc:postgresql://warehouse-postgres:5432/metropulse_dw
WAREHOUSE_JDBC_WRITE_PARTITIONS=4
# Trip-level fare/tip full loads are larger; keep connection pressure conservative.
WAREHOUSE_FARE_TIP_JDBC_WRITE_PARTITIONS=2
WAREHOUSE_JDBC_BATCH_SIZE=5000
# ML consumer login; distribute the real password outside Git.
WAREHOUSE_ML_READER_USER=metropulse_ml_reader
WAREHOUSE_ML_READER_PASSWORD=CHANGE_ME_ML_READER_PASSWORD
# Dashboard consumer login; distribute the real password outside Git.
WAREHOUSE_DASHBOARD_READER_USER=metropulse_dashboard_reader
WAREHOUSE_DASHBOARD_READER_PASSWORD=CHANGE_ME_DASHBOARD_READER_PASSWORD

# pgAdmin Web UI for PostgreSQL inspection
# Bound to VM localhost; access from personal machines through SSH tunnel.
PGADMIN_DEFAULT_EMAIL=admin@metropulse.io
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_HOST_PORT=5050

# GCP External IP (for Kafdrop access from browser)
GCP_EXTERNAL_IP=YOUR_GCP_EXTERNAL_IP_HERE
